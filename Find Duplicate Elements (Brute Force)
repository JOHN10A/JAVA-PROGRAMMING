import java.util.*;
class basic
{
    public static void main(String[] args)
    {
        int[] arr = {4, 2, 7, 2, 8, 4, 9, 7};
        ArrayList<Integer> list = new ArrayList<>();
        for(int i=0;i<arr.length;i++)
        {
            for(int j=i+1;j<arr.length;j++)
            {
                if(arr[i] == arr[j])
                {
                    list.add(arr[i]);
                    break;
                }
            }
        }
        System.out.print("Duplicate elements: "+list);
    }
}
