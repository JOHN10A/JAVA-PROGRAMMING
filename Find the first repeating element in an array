import java.util.*;
class basic
{
    public static void main(String[] args)
    {
        int[] arr = {5, 3, 8, 2, 3, 7, 8, 9};
        for(int i=0;i<arr.length;i++)
        {
            boolean duplicate = false;
            for(int j=0;j<arr.length;j++)
            {
                if(i!=j && arr[i]==arr[j])
                {
                    duplicate = true;
                    break;
                }
            }
            if(duplicate)
            {
                System.out.println("First Repeating element: "+arr[i]);
                break;
            }
        }
    }
}
