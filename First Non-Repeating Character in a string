import java.util.*;
class basic
{
    public static void main(String[] args)
    {
        String str = "aabbccddeeffghhiijjk";//17 length
        boolean[] visited = new boolean[str.length()];//17
        boolean found = false;
        int count;
        for(int i=0;i<str.length();i++)
        {
            count = 0;
            if(visited[i] != true)
            {
                for(int j=0;j<str.length();j++)
                {
                    if(str.charAt(i) == str.charAt(j))
                    {
                        count++;
                        visited[j] = true;
                    }
                }
                if(count == 1)
                {
                    System.out.print("First Non Repeating Character: "+str.charAt(i));
                    found = true;
                }
            }
            if(found)
            {
                break;
            }
        }    
    }
}
