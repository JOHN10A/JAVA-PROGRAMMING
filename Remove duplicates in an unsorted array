import java.util.*;
class basic
{
    public static void main(String[] args)
    {
        int[] arr = {4, 2, 7, 2, 4, 9, 7, 1, 9, 5, 2};
        int[] result = new int[arr.length];
        int k = 0;
        for(int i=0;i<arr.length;i++)
        {
            boolean found = false;
            for(int j=0;j<k;j++)
            {
                if(arr[i] == result[j])
                {
                    found = true;
                    break;
                }
            }
            if(!found)
            {
                result[k] = arr[i];
                k++;
            }
        }
        int n=0;
        while(n < k)
        {
            System.out.print(result[n]+" ");
            n++;
        }

    }
}
