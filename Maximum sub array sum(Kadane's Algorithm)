import java.util.*;
class basic
{
    public static void main(String[] args)
    {
        int[] arr = {2, -1, 3, -2};
        int currentsum = arr[0];//2
        int sum = arr[0];//2
        for(int i=1;i<arr.length;i++)
        {
            currentsum = Math.max(arr[i], currentsum+arr[i]);
            if(currentsum > sum)
            {
                sum = currentsum;
            }
        }
        System.out.print("Maximum sub-array aum: "+sum);
    }
}
