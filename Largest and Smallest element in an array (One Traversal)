import java.util.*;
class basic
{
    public static void main(String[] args)
    {
        int[] arr = {34, 12, 89, 5, 67, 23};
        int largest = arr[0], smallest = arr[0];
        for(int i=1;i<arr.length;i++)
        {
            if(arr[i] > largest)
            {
                largest = arr[i];
            }
            else if(arr[i] < smallest)
            {
                smallest = arr[i];
            }
        }
        System.out.print("Largest: "+largest+"\nSmallest: "+smallest);
    }
}
