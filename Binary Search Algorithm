import java.util.*;
class basic
{
    public static void main(String[] args)
    {
        Scanner sc = new Scanner(System.in);
        int[] arr = {10, 20, 50, 40, 70, 13};
        Arrays.sort(arr);//In a binary search array should be sorted
        int left = 0;
        int right = arr.length-1;
        System.out.print("Enter a number to search: ");
        int key = sc.nextInt();
        boolean found = false;
        while(left <= right)
        {
            int mid = (left + right)/2;
            if(key == arr[mid])
            {
                System.out.print("Number found at index value: "+mid);
                found = true;
                break;
            }
            else if(key > arr[mid])
            {
                left = mid  + 1;
            }
            else
            {
                right = mid - 1;
            }
        }
        if(!found)
        {
            System.out.print("Given number not found");
        }
    }
}
