import java.util.*;
class basic
{
    public static void main(String[] args)
    {
        int[] arr = {23,24,25,27,28,29,30};
        int expectedsum = 0;
        for(int start=arr[0];start<=arr[arr.length-1];start++)
        {
            expectedsum = expectedsum + start;
        }
        int actualsum = 0;
        for(int i=0;i<arr.length;i++)
        {
            actualsum = actualsum + arr[i];
        }
        int missing = expectedsum - actualsum;
        System.out.print("Missing number: "+missing);
    }
}
