import java.util.*;
class basic
{
    public static void main(String[] args)
    {
        int[] arr = {45, 12, 78, 3, 29, 16};
        double sum = 0;
        int i=0;
        while(i<arr.length)
        {
            sum = sum + arr[i];
            i++;
        }
        double avg = sum/arr.length;
        System.out.println("Average: "+avg);

    }
}
