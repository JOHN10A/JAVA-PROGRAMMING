import java.util.*;
class basic
{
    public static void main(String[] args)
    {
        int[] arr = {5, 1, 8, 3, 10, 2, 6};
        int maximum = 0;
        for(int i=0;i<arr.length-1;i++)
        {
            for(int j=i+1;j<arr.length;j++)
            {
                int diff = arr[j] - arr[i];
                if(diff > maximum)
                {
                    maximum = diff;
                }
            }
        }
        System.out.print("Maximum Difference: "+maximum);
    }
}
