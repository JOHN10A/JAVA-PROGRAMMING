import java.util.*;
class basic
{
    public static void main(String[] args)
    {
        int[] arr = {5, -2, 8, -7, 3, -1, 6};
        int left = 0;//5
        int right = arr.length-1;//6
        while(left < right)
        {
            //find positive from left
            while(left<right && arr[left]<0)
            {
                left++;
            }
            //find negative from left
            while(left<right && arr[right]>0)
            {
                right--;
            }
            if(left<right)
            {
                int temp = arr[left];
                arr[left] = arr[right];
                arr[right] = temp;//-1 -2 8 -7 3 5 6
                left++;//2
                right--;//4
            }
        }
        for(int i=0;i<arr.length;i++)
        {
            System.out.print(arr[i]+" ");
        }
    }
}
