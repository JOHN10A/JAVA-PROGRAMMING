import java.util.*;
class basic
{
    public static void main(String[] args)
    {
        int[] arr = {5, -2, 0, 8, -7, 0, 3, -1};
        int pos=0, neg=0, zero=0;
        int i=0;
        while(i<arr.length)
        {
            if(arr[i]>0)
            {
                pos++;
            }
            else if(arr[i]<0)
            {
                neg++;
            }
            else if(arr[i]==0)
            {
                zero++;
            }
            i++;
        }
        System.out.print("Positive: "+pos+"\nNegative: "+neg+"\nZeros: "+zero);
    }
}
