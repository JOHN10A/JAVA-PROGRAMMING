import java.util.*;
class basic
{
    public static void main(String[] args)
    {
        int[][] matrix = {
        {1, 2, 3},//0
        {4, 5, 6},//1
        {7, 8, 9}//2
        };
        int sum;
        for(int j=0;j<matrix.length;j++)
        {
            sum = 0;
            for(int i=0;i<matrix.length;i++)
            {
                sum = sum + matrix[i][j];
            }
            System.out.println(sum);
        }
    }
}
