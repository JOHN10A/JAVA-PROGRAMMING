import java.util.*;
class basic
{
    public static void main(String[] args)
    {
        
        int[] arr = {12, 7, 25, 12, 9, 18, 7, 31, 25, 14, 9, 42, 18, 50, 14, 63, 72, 31, 85};
        for(int i=0;i<arr.length;i++)
        {
            boolean duplicate = false;
            for(int j=0;j<arr.length;j++)
            {
                if(i!=j && arr[i]==arr[j])
                {
                    duplicate = true;
                    break;
                }
            }
            if(!duplicate)
            {
                System.out.print("First non repeating Number: "+arr[i]);
                break;
            }
        }
    }
}
