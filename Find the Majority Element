import java.util.*;
class basic
{
    public static void main(String[] args)
    {
        int[] arr = {3,3,4,4,4,4,4,4,2,3,3,5,3,4,4,4};
        boolean[] visited = new boolean[arr.length];
        int count=0, num=0;
        for(int i=0;i<arr.length;i++)
        {
            if(visited[i] == false)
            {
                int t_count = 0, t_num = 0;
                for(int j=0;j<arr.length;j++)
                {
                    if(arr[i] == arr[j])
                    {
                        visited[j] = true;
                        t_count++;
                        t_num = arr[i];
                    }
                }
                if(t_count > count)
                {
                    count = t_count;
                    num = t_num;
                }
            }
            else
            {
                continue;
            }
        }
        double n = (double)arr.length/2;
        if(count > n)
        {
            System.out.print("Majority: "+num);
        }
    }
}
