import java.util.*;
class basic
{
    public static void main(String[] args)
    {
        int[] arr = {5, 2, 10, 15, 20, 25, 30};
        boolean sorted = true;
        for(int i=1;i<arr.length;i++)
        {
            if(arr[i]>arr[i-1])
            {
                continue;
            }
            else
            {
                sorted = false;
                System.out.print("Not sorted");
                break;
            }
        }
        if(sorted)
        {
            System.out.print("Sorted");
        }

    }
}
